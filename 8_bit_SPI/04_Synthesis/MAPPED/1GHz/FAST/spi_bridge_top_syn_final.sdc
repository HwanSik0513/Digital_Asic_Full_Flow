set sdc_version 2.0

set_units -capacitance 1000fF
set_units -time 1000ps

# Set the current design
current_design spi_bridge_top

create_clock -name "ACLK" -period 1.0 -waveform {0.0 0.5} [get_ports ACLK]
create_generated_clock -name "SCLK" -divide_by 4     -source [get_ports ACLK]   [get_pins u_sclk_gen/o_sclk_reg/Q] 
set_clock_transition 0.1 [get_clocks ACLK]
set_clock_transition 0.1 [get_clocks SCLK]
set_load -pin_load 0.02 [get_ports {o_bus_rdata[7]}]
