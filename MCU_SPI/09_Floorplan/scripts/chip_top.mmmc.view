########################################
# chip_top.mmmc.view - Innovus MMMC for chip_top
# Same corners as the previous project (cmsdk_mcu.mmmc.view):
#   setup : FUNC_SS_WORST (slow 0.9 V / 125 C, RC WORST)
#   hold  : FUNC_FF_BEST  (fast 1.1 V / 0 C,  RC BEST)
# Changes: absolute PDK path (GPDK045 lives under PROJ1), SDC from chip_top
# synthesis.
########################################

if {![info exists GPDK_ROOT]} { set GPDK_ROOT "/home/hah003/PROJ1/GPDK045/digital" }
set GSC   "$GPDK_ROOT/gsclib045_all_v4.4"
set GIO   "$GPDK_ROOT/giolib045_v3.5"

########################################
########## Create RC_ Corner ###########
########################################

create_rc_corner -name BEST \
   -cap_table "$GSC/captable/cln28hpl_1p10m+alrdl_5x2yu2yz_typical.capTbl" \
   -preRoute_res {1.0} \
   -preRoute_cap {1.0} \
   -preRoute_clkres {0.0} \
   -preRoute_clkcap {0.0} \
   -postRoute_res {1.0} \
   -postRoute_cap {1.0} \
   -postRoute_xcap {1.0} \
   -postRoute_clkres {0.0} \
   -postRoute_clkcap {0.0} \
   -T 0 \
   -qx_tech_file $GSC/gsclib045/qrc/qx/gpdk045.tch

create_rc_corner -name WORST \
   -cap_table "$GSC/captable/cln28hpl_1p10m+alrdl_5x2yu2yz_typical.capTbl" \
   -preRoute_res {1.0} \
   -preRoute_cap {1.0} \
   -preRoute_clkres {0.0} \
   -preRoute_clkcap {0.0} \
   -postRoute_res {1.0} \
   -postRoute_cap {1.0} \
   -postRoute_xcap {1.0} \
   -postRoute_clkres {0.0} \
   -postRoute_clkcap {0.0} \
   -T 125 \
   -qx_tech_file $GSC/gsclib045/qrc/qx/gpdk045.tch

########################################
########## Create Library_Set ##########
########################################

create_library_set -name FF_Min_1p10v_0c \
   -timing \
    [list \
	$GSC/gsclib045/timing/fast_vdd1v0_basicCells.lib \
	$GSC/gsclib045/timing/fast_vdd1v0_multibitsDFF.lib \
	$GIO/timing/pads_FF_s1vg.lib \
    ]

create_library_set -name SS_Max_0p90v_125c \
   -timing \
    [list \
	$GSC/gsclib045/timing/slow_vdd1v0_basicCells.lib \
	$GSC/gsclib045/timing/slow_vdd1v0_multibitsDFF.lib \
	$GIO/timing/pads_SS_s1vg.lib \
    ]

########################################
########## Create Delay_Corner #########
########################################

create_delay_corner -name FF_BEST \
   -library_set FF_Min_1p10v_0c \
   -rc_corner BEST

create_delay_corner -name SS_WORST \
   -library_set SS_Max_0p90v_125c \
   -rc_corner WORST

############################################
########## Create Constraint_Mode ##########
############################################

create_constraint_mode -name FUNC \
   -sdc_files [list chip_top_pnr_in.sdc]

############################################
########### Create Analysis_view ###########
############################################

create_analysis_view -name FUNC_FF_BEST \
   -constraint_mode FUNC \
   -delay_corner FF_BEST

create_analysis_view -name FUNC_SS_WORST \
   -constraint_mode FUNC \
   -delay_corner SS_WORST

############################################
############ Set Analysis_view #############
############################################

set_analysis_view -setup [list FUNC_SS_WORST] \
   -hold [list FUNC_FF_BEST]
